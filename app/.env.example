# Copiar a `.env` (mismo directorio) y completar con los valores del proyecto.
# El archivo `.env` está en .gitignore, pero es un asset declarado en
# pubspec.yaml: si falta, dotenv.load() lanza excepción al arrancar la app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Requeridas solo para el login nativo de Google en Android/iOS (no se usan en Web).
# GOOGLE_WEB_CLIENT_ID: OAuth Client ID de tipo "Web application" en Google Cloud
#   Console. Se usa como serverClientId en ambas plataformas.
# GOOGLE_IOS_CLIENT_ID: OAuth Client ID de tipo "iOS" (solo se lee en iOS).
# En Android no hay client id de tipo "Android" en el código: el plugin
# valida el SHA-1 del certificado de firma contra el client id "Android"
# registrado en Cloud Console para el applicationId (io.luma.app). Si falta
# ese client id o el SHA-1 no coincide, el login falla en el dispositivo
# aunque el .env esté completo.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
