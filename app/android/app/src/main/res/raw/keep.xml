<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_notification e ic_notification_large solo se referencian desde Dart (por
  nombre de string, ver LocalNotificationsService), nunca desde un layout o
  manifest — R8 no puede verlos y, si algún día se activa shrinkResources en
  el build de release, los eliminaría por "no usado". Este archivo le dice
  explícitamente que los conserve.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@drawable/ic_notification_large" />
