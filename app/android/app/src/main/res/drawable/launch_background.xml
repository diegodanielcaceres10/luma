<?xml version="1.0" encoding="utf-8"?>
<!-- Brand splash: flat #12291D (AppColors.authBackgroundTop) with the leaf
     centered. Keep in sync with drawable-v21 and the Flutter SplashScreen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12291D" />
        </shape>
    </item>

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_leaf" />
    </item>
</layer-list>
