{
  "name": "web",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "build": "ng build",
    "start": "ng serve --host 0.0.0.0 --port 4200 --watch --poll=2000",
    "start:local": "ng serve --host 0.0.0.0 --port 4005 --watch --poll=2000",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "check:version": "node scripts/check-version.mjs",
    "deps:unused": "knip --dependencies",
    "lint": "ng lint",
    "clean:reports": "rimraf ./vitest || rmdir /s /q vitest",
    "test": "npm run clean:reports && ng test --watch=false --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test start:local http://localhost:4005 cy:run"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "^22.22.3"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "cypress": "^16.3.0",
    "eslint": "^10.3.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "postcss": "^8.5.3",
    "rimraf": "^6.1.4",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "cypress@16.3.0": true,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "@parcel/watcher": false
  }
}
